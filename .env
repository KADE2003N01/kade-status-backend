# Copy this file to .env, then replace every CHANGE_ME value before starting
# the backend. Never commit .env or put real passwords in this example file.

# Backend server
PORT=5000
NODE_ENV=development

# Frontend origins allowed to call this API. For production, add the exact
# deployed frontend origin (no trailing slash), separated by commas if needed.
FRONTEND_URL=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173

# Email used for document verification codes and administrator recovery links.
# For Gmail, use a Google App Password (not your normal account password).
EMAIL_USER=kadecomputerscience@gmail.com
EMAIL_PASSWORD=rnfj ntox sbck ihhi
# Optional SMTP overrides. Gmail defaults are used when SMTP_HOST is omitted.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=your-account@gmail.com

# Contact form email settings. These can use a separate mailbox; if left empty,
# EMAIL_USER and EMAIL_PASSWORD above are used as the fallback credentials.
# The notification address is where messages from the contact form are delivered.
CONTACT_EMAIL_USER=kwizeradev1@gmail.com
CONTACT_EMAIL_PASSWORD=qics ybzd ohwm vpke
CONTACT_NOTIFICATION_EMAIL=kwizeradev1@gmail.com
# Optional SMTP overrides for the contact mailbox. For Gmail, port 587 with
# CONTACT_SMTP_SECURE=false is typical; port 465 uses CONTACT_SMTP_SECURE=true.
# CONTACT_SMTP_HOST=smtp.gmail.com
# CONTACT_SMTP_PORT=587
# CONTACT_SMTP_SECURE=false
# CONTACT_SMTP_FROM=your-contact-account@gmail.com

# Administrator account created by the setup process. Choose a strong password.
ADMIN_EMAIL=kadecomputerscience@gmail.com
ADMIN_PASSWORD=kade@12345
ADMIN_DISPLAY_NAME=David
# Optional phone number shown for the primary administrator.
ADMIN_PHONE=+250788950833
# Optional second administrator (created only when all three values are set).
ADMIN_EMAIL_2=tester@gmail.com
ADMIN_PASSWORD_2=tester@12345
ADMIN_DISPLAY_NAME_2=Tester
ADMIN_PHONE_2=+250726909768

# Database and file storage
DATABASE_PATH=data/portfolio.sqlite
# On a hosting provider, set this to the persistent disk mount path.
# STORAGE_DIR=/var/data

# Optional public backend URL for generated profile-image links. Leave this
# local value for development; use the deployed backend origin only when needed.
PUBLIC_API_URL=http://localhost:5000
# Cookie policy: 'lax' works for local development and same-site deployments.
# Use 'none' only when the frontend and backend require cross-site cookies (HTTPS).
COOKIE_SAME_SITE=lax
